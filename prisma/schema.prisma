generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id         Int     @id @default(autoincrement())
  adminId    String?
  name       String
  email      String  @unique
  department String
  password   String
}

model Employee {
  id                     String                    @id @default(cuid())
  empId                  String?
  name                   String
  email                  String                    @unique
  password               String
  department             String
  role                   String                    @default("EMPLOYEE")
  supervisorId           String?
  phone                  String?
  designation            String?
  branch                 String?
  organisation           String?
  gender                 String?
  maritalStatus          String?
  nationality            String?
  joinedDate             String?
  address                String?
  emergencyContact       String?
  emergencyPhone         String?
  createdAt              DateTime                  @default(now())
  addressStreet1         String?
  addressStreet2         String?
  city                   String?
  country                String?
  cpn                    String?
  dateOfBirth            String?
  employmentStatus       String?
  extension              String?
  otherEmail             String?
  state                  String?
  workTelephone          String?
  workWeekMapping        String?
  zipCode                String?
  marriageAnniversary    String?
  pan                    String?
  uan                    String?
  basicSalary            String?
  bonus                  String?
  conveyance             String?
  deductions             String?
  hra                    String?
  medical                String?
  pfEmployee             String?
  pfEmployer             String?
  professionalTax        String?
  specialAllowance       String?
  tds                    String?
  aadharNo               String?
  bankAccountNo          String?
  bankName               String?
  ifscCode               String?
  esicNo                 String?
  bloodGroup             String?
  chargeType             String?
  employmentToDate       String?
  grade                  String?
  langRead               String?
  langSpeak              String?
  langWrite              String?
  annualCtc              String?
  employeeType           String?
  fatherName             String?
  identificationMark     String?
  passportNo             String?
  ndaNo                  String?
  siteOffice             String?
  position               String?
  assignedModules        String[]                  @default([])
  photoUrl               String?
  title                  String?
  confirmationDate       String?
  creditAccount          String?
  debitAccount           String?
  probationPeriod        String?
  leavingReasonId        String?
  terminationDate        String?
  religion               String?
  offDaysTemplates       String[]                  @default([])
  monthlyCtc             String?
  appraisalsAsAppraiser  AppraisalAssignment[]     @relation("AppraisalAppraiser")
  appraisalsAsEmployee   AppraisalAssignment[]     @relation("AppraisalEmployee")
  appraisalsAsReviewer   AppraisalAssignment[]     @relation("AppraisalReviewer")
  assignedGpsLocations   AssignedGpsLocation[]
  attendances            Attendance[]
  bankDetails            BankDetail[]
  bonusIncentives        BonusIncentive[]
  dependents             Dependent[]
  accountsDocMappings    DocWorkflowMapping[]      @relation("AccountsDocRelation")
  docWorkflowMapping     DocWorkflowMapping?
  hodMappings            DocWorkflowMapping[]      @relation("HodRelation")
  hrMappings             DocWorkflowMapping[]      @relation("HrRelation")
  educations             Education[]
  emergencyContacts      EmergencyContact[]
  leavingReason          LeavingReason?            @relation(fields: [leavingReasonId], references: [id])
  supervisor             Employee?                 @relation("SupervisorRelation", fields: [supervisorId], references: [id])
  subordinates           Employee[]                @relation("SupervisorRelation")
  documents              EmployeeDocument[]
  shifts                 EmployeeShift[]
  generatedDocuments     GeneratedDocument[]
  imprestRequests        ImprestRequest[]
  accountsWorkflows      ImprestWorkflowConfig[]   @relation("AccountsRel")
  adminWorkflows         ImprestWorkflowConfig[]   @relation("AdminRel")
  projectsHeadWorkflows  ImprestWorkflowConfig[]   @relation("ProjectsHeadRel")
  jobHistories           JobHistory[]
  leaveBalance           LeaveBalance?
  leaveEncashments       LeaveEncashment[]
  leaveRequests          LeaveRequest[]
  ltaApplications        LeaveTravelAllowance[]
  locationRequests       LocationRequest[]
  marketingFollowups     MarketingFollowup[]
  marketingLeads         MarketingLead[]           @relation("LeadOwner")
  marketingOpportunities MarketingOpportunity[]    @relation("OpportunityOwner")
  orgChartNode           OrgChartNode?
  overtimeAssignments    OvertimeAssignment[]
  payrollRecords         PayrollRecord[]
  activitiesResponsible  ProjectActivity[]         @relation("ActivityResponsible")
  mbsCertified           ProjectMB[]               @relation("MBCertifier")
  projectManaged         ProjectMaster[]           @relation("ProjectManager")
  projectTeamsMember     ProjectTeam[]             @relation("ProjectTeamMember")
  punchRequests          PunchRequest[]
  approvedIndents        PurchaseApproval[]
  purchaseIndents        PurchaseIndent[]
  ncrsRaised             QualityNCR[]              @relation("NCRRaiser")
  safetyLogsLogged       SafetyLog[]               @relation("SafetyLogger")
  salaryRevisions        SalaryRevision[]
  dprsPrepared           SiteDPR[]                 @relation("DPRPreparer")
  materialRequesters     SiteMaterialRequisition[] @relation("MaterialRequester")
  tdsFilings             TdsFiling[]
  tenderOwner            Tender[]                  @relation("TenderOwner")
  tenderApprover         TenderApproval[]          @relation("TenderApprover")
  tenderAuditor          TenderAuditLog[]          @relation("TenderAuditor")
  tenderDocUploader      TenderDocument[]          @relation("TenderDocUploader")
  tenderSubmitter        TenderSubmission[]        @relation("TenderSubmitter")
  tripLogs               TripLog[]
  vehicles               Vehicle[]
  vendorCreator          VendorMaster[]
  workExperiences        WorkExperience[]

  @@index([role])
  @@index([supervisorId])
  @@index([empId])
}

model EmergencyContact {
  id           Int      @id @default(autoincrement())
  employeeId   String
  name         String?
  phone        String?
  relationship String?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model TdsFiling {
  id         String   @id @default(cuid())
  employeeId String
  month      String
  year       String
  amount     Float
  fileUrl    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model GratuitySetup {
  id              String   @id @default(cuid())
  fromDate        String
  toDate          String
  minServedLimit  Int
  maxPayableLimit Float
  formula         String
  monthsRoundOff  String
  denominator     Int
  subtractor      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrgChartNode {
  id             String         @id @default(cuid())
  employeeId     String?        @unique
  parentId       String?
  department     String?
  isVacant       Boolean        @default(false)
  jobDescription String?
  positionTitle  String?
  candidates     Candidate[]
  employee       Employee?      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  parent         OrgChartNode?  @relation("OrgChartHierarchy", fields: [parentId], references: [id])
  children       OrgChartNode[] @relation("OrgChartHierarchy")
}

model Dependent {
  id           Int      @id @default(autoincrement())
  employeeId   String
  name         String
  relationship String
  dateOfBirth  String?
  phone        String?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId String
  date       String
  status     String
  shiftType  String   @default("Day")
  timeSlots  String?
  isApproved Boolean  @default(false)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
}

model PunchRequest {
  id           Int      @id @default(autoincrement())
  employeeId   String
  type         String
  time         String
  date         String
  shiftType    String   @default("Day")
  status       String   @default("PENDING")
  reason       String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  locationName String?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([employeeId, date])
}

model LeaveBalance {
  id                 Int      @id @default(autoincrement())
  employeeId         String   @unique
  casualLeaves       Float    @default(12)
  leaveWithoutPay    Float    @default(0)
  earnedLeaves       Float    @default(15)
  compensatoryLeaves Float    @default(0)
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id                   Int       @id @default(autoincrement())
  employeeId           String
  leaveType            String
  startDate            String
  endDate              String
  reason               String
  attachment           String?
  status               String    @default("PENDING_SUPERVISOR")
  isHalfDay            Boolean   @default(false)
  appliedOn            DateTime  @default(now())
  supervisorApproved   Boolean   @default(false)
  supervisorApprovedAt DateTime?
  supervisorApprovedBy String?
  adminApproved        Boolean   @default(false)
  adminApprovedAt      DateTime?
  adminApprovedBy      String?
  targetSupervisorId   String?
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([startDate, endDate])
  @@index([employeeId])
}

model LeaveEncashment {
  id            Int      @id @default(autoincrement())
  employeeId    String
  leaveType     String   @default("Earned Leave")
  asOnDate      String
  balanceBefore Float    @default(0)
  encashedDays  Float    @default(0)
  amountPerDay  Float    @default(0)
  totalAmount   Float    @default(0)
  message       String?
  isProcessed   Boolean  @default(false)
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Holiday {
  id   Int    @id @default(autoincrement())
  name String
  date String @unique
  type String @default("Public")
}

model AccountSettings {
  id                     Int      @id @default(autoincrement())
  companyName            String   @default("Cecube Engineering India Pvt Ltd")
  holidayPunchHandling   String   @default("PROCESS_AS_REGULAR")
  weekOffPunchHandling   String   @default("PROCESS_AS_REGULAR")
  enableOvertime         Boolean  @default(false)
  computeOvertimeBasedOn String   @default("WORKED_HOURS")
  otStartMinutes         Int      @default(0)
  otDailyCapHours        Int      @default(0)
  updatedAt              DateTime @updatedAt
}

model WorkWeek {
  id        Int     @id @default(autoincrement())
  day       String  @unique
  isWorking Boolean @default(true)
}

model LeaveType {
  id                Int     @id @default(autoincrement())
  name              String
  isPaid            Boolean @default(false)
  isActive          Boolean @default(true)
  includeWeeklyOff  Boolean @default(false)
  includeHoliday    Boolean @default(false)
  considerAsPresent Boolean @default(false)
}

model GpsLocation {
  id           Int      @id @default(autoincrement())
  name         String
  address      String?
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(100)
  locationType String   @default("Office")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Announcement {
  id           Int      @id @default(autoincrement())
  subject      String
  message      String?
  isHoliday    Boolean  @default(false)
  date         String?
  createdAt    DateTime @default(now())
  isWorkingDay Boolean  @default(false)
}

model LocationRequest {
  id           Int            @id @default(autoincrement())
  employeeId   String
  status       String         @default("PENDING")
  latitude     Float?
  longitude    Float?
  address      String?
  movementType String?
  requestedAt  DateTime       @default(now())
  respondedAt  DateTime?
  pings        LocationPing[]
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LocationPing {
  id        Int             @id @default(autoincrement())
  requestId Int
  latitude  Float
  longitude Float
  timestamp DateTime        @default(now())
  request   LocationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model EmployeeDocument {
  id             Int      @id @default(autoincrement())
  employeeId     String
  documentType   String
  documentName   String
  documentNumber String?
  expiryDate     String?
  fileData       String
  fileName       String
  fileType       String
  createdAt      DateTime @default(now())
  effectiveDate  String?
  ocrText        String?
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id               Int       @id @default(autoincrement())
  employeeId       String?
  isCompanyVehicle Boolean   @default(false)
  makeModel        String
  plateNumber      String    @unique
  vehicleType      String
  ratePerKm        Float     @default(0.0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  trips            TripLog[]
  employee         Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model TripLog {
  id            Int        @id @default(autoincrement())
  employeeId    String
  vehicleId     Int
  date          String?
  startLocation String?
  endLocation   String?
  distanceKm    Float?     @default(0.0)
  amount        Float?     @default(0.0)
  status        String     @default("REQUESTED")
  createdAt     DateTime   @default(now())
  reason        String?
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  pings         TripPing[]

  @@index([status])
  @@index([employeeId])
}

model TripPing {
  id        Int      @id @default(autoincrement())
  tripId    Int
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
  trip      TripLog  @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id              Int      @id @default(autoincrement())
  subject         String
  message         String
  recipientCount  Int      @default(0)
  recipientEmails String?
  recipientNames  String?
  attachmentName  String?
  emailType       String   @default("general")
  status          String   @default("SENT")
  errorMessage    String?
  sentBy          String?
  createdAt       DateTime @default(now())
}

model OvertimeAssignment {
  id         Int      @id @default(autoincrement())
  employeeId String
  date       String
  hours      String?
  reason     String?
  status     String   @default("ASSIGNED")
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model BankDetail {
  id            Int      @id @default(autoincrement())
  employeeId    String
  bankName      String?
  accountName   String?
  accountNumber String?
  ifscCode      String?
  branch        String?
  address       String?
  branchCode    String?
  isPrimary     Boolean  @default(false)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id             Int      @id @default(autoincrement())
  employeeId     String
  companyName    String?
  jobTitle       String?
  fromDate       String?
  toDate         String?
  jobDescription String?
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Education {
  id          Int      @id @default(autoincrement())
  employeeId  String
  institution String?
  degree      String?
  year        String?
  grade       String?
  course      String?
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Department {
  id           String   @id @default(cuid())
  name         String
  organization String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  organization String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteOffice {
  id           String   @id @default(cuid())
  name         String
  organization String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Designation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Grade {
  id          String   @id @default(cuid())
  designation String   @default("")
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([designation, name])
}

model Position {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bgColor     String?  @default("#f3f4f6")
  textColor   String?  @default("#1f2937")
  code        String?  @unique
}

model EmployeeCodeCounter {
  id         Int      @id @default(autoincrement())
  prefix     String   @unique
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model JobHistory {
  id          Int      @id @default(autoincrement())
  employeeId  String
  siteOffice  String?
  branch      String?
  department  String?
  designation String?
  chargeType  String?
  fromDate    String
  toDate      String?
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model ImprestRequest {
  id                 Int              @id @default(autoincrement())
  requestId          String           @unique
  employeeId         String
  amountRequested    Float
  purpose            String
  requiredDate       String
  projectSite        String?
  status             String           @default("PENDING")
  approvedAmount     Float?
  approverId         String?
  approvalDate       DateTime?
  remarks            String?
  issueDate          DateTime?
  issuedAmount       Float?
  paymentMode        String?
  transactionRef     String?
  settledStatus      String           @default("OPEN")
  settlementDate     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  imprestHead        String?
  imprestType        String?
  targetSupervisorId String?
  expenses           ImprestExpense[]
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([employeeId])
}

model ImprestExpense {
  id               Int            @id @default(autoincrement())
  imprestRequestId Int
  expenseDate      String
  category         String
  description      String
  vendorName       String?
  billNo           String?
  billAmount       Float
  billUpload       String?
  status           String         @default("PENDING")
  createdAt        DateTime       @default(now())
  imprestRequest   ImprestRequest @relation(fields: [imprestRequestId], references: [id], onDelete: Cascade)
}

model ImprestWorkflowConfig {
  id             Int       @id @default(1)
  projectsHeadId String?
  accountsId     String?
  adminId        String?
  updatedAt      DateTime  @updatedAt
  accounts       Employee? @relation("AccountsRel", fields: [accountsId], references: [id])
  admin          Employee? @relation("AdminRel", fields: [adminId], references: [id])
  projectsHead   Employee? @relation("ProjectsHeadRel", fields: [projectsHeadId], references: [id])
}

model ImprestHead {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model GeneratedDocument {
  id               Int       @id @default(autoincrement())
  employeeId       String
  formType         String
  formData         String
  status           String    @default("PENDING_SUPERVISOR")
  supervisorId     String?
  supervisorStatus String?
  supervisorDate   DateTime?
  supervisorNotes  String?
  hodId            String?
  hodStatus        String?
  hodDate          DateTime?
  hodNotes         String?
  hrId             String?
  hrStatus         String?
  hrDate           DateTime?
  hrNotes          String?
  accountsId       String?
  accountsStatus   String?
  accountsDate     DateTime?
  accountsNotes    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([employeeId])
}

model DocWorkflowMapping {
  id         Int       @id @default(autoincrement())
  employeeId String    @unique
  hodId      String?
  hrId       String?
  accountsId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  accounts   Employee? @relation("AccountsDocRelation", fields: [accountsId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hod        Employee? @relation("HodRelation", fields: [hodId], references: [id])
  hr         Employee? @relation("HrRelation", fields: [hrId], references: [id])
}

model Candidate {
  id             String        @id @default(cuid())
  name           String
  email          String?       @unique
  phone          String?
  appliedFor     String?
  department     String?
  status         String        @default("PENDING")
  resumeUrl      String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orgChartNodeId String?
  orgChartNode   OrgChartNode? @relation(fields: [orgChartNodeId], references: [id])
}

model Supplier {
  id          String       @id @default(cuid())
  name        String       @unique
  group       String?
  owner       String?
  contactNo   String?
  status      String       @default("Regular")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  contractors Contractor[] @relation("ContractorToSupplier")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplierGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id                  String            @id @default(cuid())
  name                String
  company             String
  library             String
  state               String
  builtUpArea         String?           @default("0.0000")
  saleableArea        String?           @default("0.0000")
  startDate           String?           @default("01/01/2026 00:00:00")
  endDate             String?           @default("01/01/2026 00:00:00")
  cost                String?           @default("0.0000\n01/01/1900")
  status              String?           @default("Planning")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  category1           String?
  category2           String?
  companyId           String?
  policies            InsurancePolicy[]
  companyRel          Company?          @relation(fields: [companyId], references: [id])
  wbsTasks            ProjectWbsTask[]
  requisitions        Requisition[]
  wbsGroups           WbsGroup[]
  wbsBifurcationTasks WbsTask[]

  @@index([companyId])
}

model ProjectWbsTask {
  id                      String                    @id @default(cuid())
  projectId               String
  taskName                String
  approvedBuiltUpArea     Float                     @default(0)
  approvedRate            Float                     @default(0)
  approvedAmount          Float                     @default(0)
  allocatedRate           Float                     @default(0)
  allocatedAmount         Float                     @default(0)
  allocatedEstimateRate   Float                     @default(0)
  allocatedEstimateAmount Float                     @default(0)
  unallocatedRate         Float                     @default(0)
  unallocatedAmount       Float                     @default(0)
  estimateRate            Float                     @default(0)
  estimateAmount          Float                     @default(0)
  expendedRate            Float                     @default(0)
  expendedAmount          Float                     @default(0)
  budgetHeadCategory      String?
  remark                  String?
  isLocked                Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  wbsGroupId              String?
  wbsTaskId               String?
  budgetHistories         ProjectWbsBudgetHistory[]
  project                 Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectWbsBudgetHistory {
  id               String         @id @default(cuid())
  projectWbsTaskId String
  changes          Json
  createdAt        DateTime       @default(now())
  task             ProjectWbsTask @relation(fields: [projectWbsTaskId], references: [id], onDelete: Cascade)
}

model Company {
  id                String            @id @default(cuid())
  name              String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  code              String?
  status            String?           @default("Active")
  type              String?
  contractors       Contractor[]
  insurancePolicies InsurancePolicy[]
  labourers         Labour[]
  policyTypes       PolicyType[]
  projects          Project[]
  tdsChallans       TDSChallan[]      @relation("TDSChallans")
  tdsSections       TDSSection[]
}

model Library {
  id             String                 @id @default(cuid())
  name           String                 @unique
  type           String?
