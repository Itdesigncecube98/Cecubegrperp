/// ERP system users (can map to an Employee record or be standalone admins)
model SystemUser {
  id             String        @id @default(cuid())
  username       String        @unique
  email          String        @unique
  passwordHash   String
  displayName    String
  employeeId     String?
  companyId      String?
  status         String        @default("Active")
  isSuperAdmin   Boolean       @default(false)
  lastLoginAt    DateTime?
  failedAttempts Int           @default(0)
  lockedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?
  auditLogs      AuditLog[]
  userRoles      UserRole[]
  sessions       UserSession[]

  @@index([email])
  @@index([status])
  @@index([companyId])
}

/// A role is a named set of permissions (e.g., "HR Manager", "Site Engineer")
model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  companyId       String?
  isSystem        Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

/// Module-level permission definition
model Permission {
  id              String           @id @default(cuid())
  module          String
  subModule       String?
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([module, subModule, action])
  @@index([module])
}

/// Many-to-many: Role ↔ Permission
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  grantedBy    String?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// Assigns one or more roles to a system user, optionally scoped to a project/company
model UserRole {
  id         String     @id @default(cuid())
  userId     String
  roleId     String
  companyId  String?
  projectId  String?
  validFrom  DateTime   @default(now())
  validTo    DateTime?
  assignedBy String?
  createdAt  DateTime   @default(now())
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId, projectId])
  @@index([userId])
  @@index([roleId])
}

/// Immutable audit trail for every significant action in the ERP
model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  employeeId String?
  module     String
  subModule  String?
  action     String
  entityType String?
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  userAgent  String?
  status     String      @default("SUCCESS")
  remarks    String?
  createdAt  DateTime    @default(now())
  user       SystemUser? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// License management
model LicenseKey {
  id          String    @id @default(cuid())
  key         String    @unique
  companyId   String?
  plan        String    @default("Standard")
  maxUsers    Int       @default(10)
  modules     String[]  @default([])
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime?
  activatedAt DateTime?
  isActive    Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Track active/historical login sessions
model UserSession {
  id        String     @id @default(cuid())
  userId    String
  token     String     @unique
  ipAddress String?
  userAgent String?
  loginAt   DateTime   @default(now())
  logoutAt  DateTime?
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  user      SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

/// Security policy configuration (password rules, session timeout, 2FA, etc.)
model SecurityPolicy {
  id                      Int      @id @default(1)
  minPasswordLength       Int      @default(8)
  requireUppercase        Boolean  @default(true)
  requireLowercase        Boolean  @default(true)
  requireNumbers          Boolean  @default(true)
  requireSpecialChars     Boolean  @default(false)
  passwordExpiryDays      Int      @default(90)
  maxFailedAttempts       Int      @default(5)
  lockoutDurationMins     Int      @default(30)
  sessionTimeoutMins      Int      @default(480)
  twoFactorEnabled        Boolean  @default(false)
  ipWhitelistEnabled      Boolean  @default(false)
  ipWhitelist             String[] @default([])
  updatedAt               DateTime @updatedAt
  updatedBy               String?
  allowMultipleSessions   Boolean  @default(true)
  apiAccessEnabled        Boolean  @default(false)
  apiTokenExpiryDays      Int      @default(30)
  deviceManagementEnabled Boolean  @default(false)
  passwordResetVia        String   @default("EMAIL")
}

/// Scopes a user/role to specific companies, projects, sites, branches, or departments
model DataScopeAccess {
  id         String   @id @default(cuid())
  userId     String?
  roleId     String?
  scopeType  String
  scopeValue String
  module     String
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([roleId])
  @@index([scopeType])
  @@index([module])
}

/// Enables or disables an entire module for a user or role
model ModuleRight {
  id        String   @id @default(cuid())
  userId    String?
  roleId    String?
  module    String
  isEnabled Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module])
  @@unique([roleId, module])
  @@index([userId])
  @@index([roleId])
  @@index([module])
}

/// License activation record — machine/server/DB binding
model LicenseActivation {
  id          String    @id @default(cuid())
  licenseId   String
  machineId   String?
  databaseId  String?
  activatedAt DateTime  @default(now())
  activatedBy String?
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime?
  revokedBy   String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([licenseId])
}

/// Per-module licensing (which modules are enabled for a license)
model LicenseModuleRight {
  id        String   @id @default(cuid())
  licenseId String
  module    String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([licenseId, module])
  @@index([licenseId])
}

/// Immutable record of every login attempt
model LoginHistory {
  id         String   @id @default(cuid())
  userId     String?
  username   String
  status     String   @default("SUCCESS")
  ipAddress  String?
  userAgent  String?
  deviceInfo String?
  failReason String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

/// Admin-configurable system-wide settings (singleton, id=1)
model SystemSettings {
  id                    Int      @id @default(1)
  financialYearStart    String   @default("April")
  currency              String   @default("INR")
  currencySymbol        String   @default("₹")
  dateFormat            String   @default("DD/MM/YYYY")
  numberFormat          String   @default("Indian")
  timezone              String   @default("Asia/Kolkata")
  gstEnabled            Boolean  @default(true)
  gstin                 String?
  gstFilingFrequency    String   @default("Monthly")
  smtpHost              String?
  smtpPort              Int      @default(587)
  smtpUser              String?
  smtpPassword          String?
  smtpFromName          String   @default("CeCube ERP")
  smtpFromEmail         String?
  smtpSecure            Boolean  @default(true)
  smsGateway            String?
  smsApiKey             String?
  whatsappApiKey        String?
  whatsappFromNumber    String?
  poPrefix              String   @default("PO")
  poStartNumber         Int      @default(1001)
  empPrefix             String   @default("EMP")
  empStartNumber        Int      @default(1001)
  invoicePrefix         String   @default("INV")
  invoiceStartNumber    Int      @default(1001)
  autoNumberingEnabled  Boolean  @default(true)
  resetNumberingYearly  Boolean  @default(true)
  maxApprovalLevels     Int      @default(3)
  autoBackupEnabled     Boolean  @default(false)
  backupFrequency       String   @default("Daily")
  backupRetentionDays   Int      @default(30)
  emailNotifications    Boolean  @default(true)
  smsNotifications      Boolean  @default(false)
  whatsappNotifications Boolean  @default(false)
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

model MarketingLead {
  id                    String                 @id @default(cuid())
  leadId                String                 @unique
  leadDate              DateTime               @default(now())
  leadSource            String
  leadType              String
  leadOwnerId           String
  clientId              String?
  companyName           String
  contactPerson         String
  mobile                String
  email                 String
  location              String
  industry              String
  gstNo                 String?
  projectName           String
  projectLocation       String
  projectType           String
  requirement           String?
  estimatedProjectValue Float?
  expectedStartDate     DateTime?
  expectedClosingDate   DateTime?
  competitor            String?
  remarks               String?
  documents             Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  leadStatus            LeadStatus             @default(New)
  followups             MarketingFollowup[]
  client                MarketingClient?       @relation(fields: [clientId], references: [id])
  leadOwner             Employee               @relation("LeadOwner", fields: [leadOwnerId], references: [id])
  opportunities         MarketingOpportunity[]
}

model MarketingClient {
  id                      String                 @id @default(cuid())
  companyName             String                 @unique
  contactPerson           String?
  mobile                  String?
  email                   String?
  industry                String?
  address                 String?
  gstNo                   String?
  previousBusinessHistory String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  leads                   MarketingLead[]
  opportunities           MarketingOpportunity[]
}

model MarketingFollowup {
  id               String                @id @default(cuid())
  leadId           String?
  opportunityId    String?
  activityType     String
  discussion       String
  commitment       String?
  nextFollowUpDate DateTime?
  nextAction       String?
  createdById      String
  createdAt        DateTime              @default(now())
  createdBy        Employee              @relation(fields: [createdById], references: [id])
  lead             MarketingLead?        @relation(fields: [leadId], references: [id])
  opportunity      MarketingOpportunity? @relation(fields: [opportunityId], references: [id])
}

model MarketingOpportunity {
  id                  String              @id @default(cuid())
  leadId              String
  clientId            String
  estimatedValue      Float
  probabilityPercent  Float
  expectedClosingDate DateTime
  salesStage          String
  ownerId             String
  competitor          String?
  status              String              @default("Open")
  lostReason          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  documents           Json?
  followups           MarketingFollowup[]
  client              MarketingClient     @relation(fields: [clientId], references: [id])
  lead                MarketingLead       @relation(fields: [leadId], references: [id])
  owner               Employee            @relation("OpportunityOwner", fields: [ownerId], references: [id])
  proposals           MarketingProposal[]
  tenders             MarketingTender[]
}

model MarketingProposal {
  id            String                 @id @default(cuid())
  opportunityId String
  estimatedCost Float
  quotedAmount  Float
  margin        Float?
  discount      Float?
  finalAmount   Float
  paymentTerms  String?
  deliveryTerms String?
  validity      DateTime?
  status        String                 @default("Draft")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  negotiations  MarketingNegotiation[]
  opportunity   MarketingOpportunity   @relation(fields: [opportunityId], references: [id])
}

model MarketingNegotiation {
  id           String            @id @default(cuid())
  proposalId   String
  round        Int
  clientOffer  Float
  companyOffer Float
  discount     Float?
  finalOffer   Float?
  status       String
  createdAt    DateTime          @default(now())
  proposal     MarketingProposal @relation(fields: [proposalId], references: [id])
}

model MarketingTender {
  id            String               @id @default(cuid())
  opportunityId String
  referenceNo   String
  status        String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  opportunity   MarketingOpportunity @relation(fields: [opportunityId], references: [id])
}

model Tender {
  id                 String               @id @default(cuid())
  tenderNo           String?              @unique
  referenceNo        String?
  title              String
  tenderDate         DateTime?
  source             String?
  authority          String?
  clientName         String?
  projectName        String?
  projectLocation    String?
  tenderType         String?
  tenderValue        Float?               @default(0)
  currency           String?              @default("INR")
  publishedDate      DateTime?
  docDownloadStart   DateTime?
  preBidMeeting      DateTime?
  querySubLastDate   DateTime?
  bidSubStart        DateTime?
  bidSubLastDate     DateTime?
  techOpeningDate    DateTime?
  finOpeningDate     DateTime?
  expectedResultDate DateTime?
  status             String               @default("Evaluation")
  ownerId            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  owner              Employee?            @relation("TenderOwner", fields: [ownerId], references: [id])
  approvals          TenderApproval[]
  auditLogs          TenderAuditLog[]
  boqItems           TenderBOQItem[]
  bids               TenderBid?
  costing            TenderCosting?
  documents          TenderDocument[]
  evaluations        TenderEvaluation[]
  result             TenderOpeningResult?
  submission         TenderSubmission?
}

model TenderEvaluation {
  id                 String   @id @default(cuid())
  tenderId           String
  clientProfileScore Int      @default(0)
  projectExpScore    Int      @default(0)
  techEligibleScore  Int      @default(0)
  finEligibleScore   Int      @default(0)
  similarWorkScore   Int      @default(0)
  locationScore      Int      @default(0)
  paymentTermsScore  Int      @default(0)
  projectMarginScore Int      @default(0)
  totalScore         Int      @default(0)
  decision           String?
  reason             String?
  expectedMargin     Float?
  competition        String?
  resourceAvail      String?
  risk               String?
  remarks            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tender             Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
}

model TenderDocument {
  id           String    @id @default(cuid())
  tenderId     String
  name         String
  type         String
  version      String    @default("V1")
  url          String
  remarks      String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  tender       Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  uploadedBy   Employee? @relation("TenderDocUploader", fields: [uploadedById], references: [id])
}

model TenderBOQItem {
  id            String  @id @default(cuid())
  tenderId      String
  serialNo      String?
  description   String
  unit          String?
  quantity      Float   @default(0)
  clientRate    Float   @default(0)
  estimatedRate Float   @default(0)
  tender        Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
}

model TenderCosting {
  id              String @id @default(cuid())
  tenderId        String @unique
  materialCost    Float  @default(0)
  labourCost      Float  @default(0)
  subcontractCost Float  @default(0)
  equipmentCost   Float  @default(0)
  transportCost   Float  @default(0)
  accommodation   Float  @default(0)
  food            Float  @default(0)
  siteEstabCost   Float  @default(0)
  overhead        Float  @default(0)
  insurance       Float  @default(0)
  taxes           Float  @default(0)
  contingency     Float  @default(0)
  financeCost     Float  @default(0)
  otherCost       Float  @default(0)
  totalCost       Float  @default(0)
  quotedValue     Float  @default(0)
  grossProfit     Float  @default(0)
  marginPercent   Float  @default(0)
  tender          Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
}

model TenderBid {
  id              String  @id @default(cuid())
  tenderId        String  @unique
  basicPrice      Float   @default(0)
  gstAmount       Float   @default(0)
  discount        Float   @default(0)
  freight         Float   @default(0)
  otherCharges    Float   @default(0)
  finalBidValue   Float   @default(0)
  paymentTerms    String?
  retention       String?
  ld              String?
  warranty        String?
  securityDeposit String?
  performanceBg   String?
  emd             String?
  tender          Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
}

model TenderApproval {
  id           String    @id @default(cuid())
  tenderId     String
  stage        String
  status       String
  remarks      String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  approvedBy   Employee? @relation("TenderApprover", fields: [approvedById], references: [id])
  tender       Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
}

model TenderSubmission {
  id              String    @id @default(cuid())
  tenderId        String    @unique
  mode            String?
  submissionDate  DateTime?
  portalName      String?
  portalRef       String?
  techBidFileUrl  String?
  commBidFileUrl  String?
  emdDetails      String?
  tenderFee       Float?    @default(0)
  acknowledgement String?
  remarks         String?
  submittedById   String?
  createdAt       DateTime  @default(now())
  submittedBy     Employee? @relation("TenderSubmitter", fields: [submittedById], references: [id])
  tender          Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
}

model TenderOpeningResult {
  id              String    @id @default(cuid())
  tenderId        String    @unique
  techQualified   Boolean   @default(false)
  techReason      String?
  ourBidValue     Float?    @default(0)
  rank            String?
  competitor1Name String?
  competitor1Bid  Float?    @default(0)
  competitor2Name String?
  competitor2Bid  Float?    @default(0)
  competitor3Name String?
  competitor3Bid  Float?    @default(0)
  finalStatus     String?
  lossReason      String?
  loaNo           String?
  loaDate         DateTime?
  contractValue   Float?
  createdAt       DateTime  @default(now())
  tender          Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
}

model TenderAuditLog {
  id        String    @id @default(cuid())
  tenderId  String
  action    String
  oldValue  String?
  newValue  String?
  remarks   String?
  userId    String?
  createdAt DateTime  @default(now())
  tender    Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  user      Employee? @relation("TenderAuditor", fields: [userId], references: [id])
}

model VendorMaster {
  id            String              @id @default(cuid())
  vendorCode    String?             @unique
  name          String
  type          String?
  contactPerson String?
  mobile        String?
  email         String?
  address       String?
  city          String?
  state         String?
  gstin         String?
  pan           String?
  msmeStatus    Boolean             @default(false)
  bankName      String?
  accountNo     String?
  ifsc          String?
  paymentTerms  String?
  creditDays    Int?                @default(0)
  category      String?
  rating        Float?              @default(0)
  status        String              @default("Active")
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  accountName   String?
  documents     String?
  fixedGroup    String?
  godownAddress String?
  whatsappNo    String?
  rfqs          PurchaseRFQVendor[]
  createdBy     Employee?           @relation(fields: [createdById], references: [id])
  quotations    VendorQuotation[]
}

model PurchaseIndent {
  id                       String                    @id @default(cuid())
  prNo                     String                    @unique
  prDate                   DateTime                  @default(now())
  department               String?
  project                  String?
  site                     String?
  requiredDate             DateTime?
  priority                 String                    @default("Normal")
  purpose                  String?
  remarks                  String?
  status                   String                    @default("Pending Approval")
  requestedById            String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  approvals                PurchaseApproval[]
  requestedBy              Employee?                 @relation(fields: [requestedById], references: [id])
  items                    PurchaseIndentItem[]
  rfqs                     PurchaseRFQ[]
  siteMaterialRequisitions SiteMaterialRequisition[]
}

model PurchaseIndentItem {
  id             String                @id @default(cuid())
  indentId       String
  item           String
  specification  String?
  unit           String
  quantity       Float
  requiredDate   DateTime?
  indent         PurchaseIndent        @relation(fields: [indentId], references: [id], onDelete: Cascade)
  quotationItems VendorQuotationItem[]
}

model PurchaseApproval {
  id           String          @id @default(cuid())
  indentId     String?
  poId         String?
  stage        String
  status       String          @default("Pending")
  remarks      String?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   Employee?       @relation(fields: [approvedById], references: [id])
  indent       PurchaseIndent? @relation(fields: [indentId], references: [id], onDelete: Cascade)
}

model PurchaseRFQ {
  id            String              @id @default(cuid())
  rfqNo         String              @unique
  rfqDate       DateTime            @default(now())
  indentId      String
  project       String?
  requiredDate  DateTime?
  dueDate       DateTime?
  paymentTerms  String?
  deliveryTerms String?
  warranty      String?
  specialCond   String?
  status        String              @default("Open")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  expiryDate    DateTime?
  indent        PurchaseIndent      @relation(fields: [indentId], references: [id])
  vendors       PurchaseRFQVendor[]
  quotations    VendorQuotation[]
}

model PurchaseRFQVendor {
  id       String       @id @default(cuid())
  rfqId    String
  vendorId String
  status   String       @default("Sent")
  rfq      PurchaseRFQ  @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor   VendorMaster @relation(fields: [vendorId], references: [id])
}

model VendorQuotation {
  id                 String                @id @default(cuid())
  rfqId              String?
  vendorId           String
  date               DateTime              @default(now())
  basicAmount        Float                 @default(0)
  discount           Float                 @default(0)
  gst                Float                 @default(0)
  finalAmount        Float                 @default(0)
  docsUrl            String?
  createdAt          DateTime              @default(now())
  deliveryTerms      String?
  documents          String?
  freightCharges     String?
  insurance          String?
  materialInspection String?
  otherConditions    String?
  paymentTerms       String?
  taxAndDuties       String?
  transactionMode    String?
  warranty           String?
  rfq                PurchaseRFQ?          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor             VendorMaster          @relation(fields: [vendorId], references: [id])
  items              VendorQuotationItem[]
}

model VendorQuotationItem {
  id           String              @id @default(cuid())
  quotationId  String
  item         String
  quantity     Float
  rate         Float
  discount     Float               @default(0)
  gst          Float               @default(0)
  amount       Float
  approvedAt   DateTime?
  brand        String?
  indentItemId String?
  isSelected   Boolean             @default(false)
  indentItem   PurchaseIndentItem? @relation(fields: [indentItemId], references: [id])
  quotation    VendorQuotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([indentItemId])
}

model AccountsAccountGroup {
  id          String                 @id @default(cuid())
  name        String                 @unique
  type        String
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  ledgers     AccountsLedgerMaster[]
}

model AccountsLedgerMaster {
  id             String                  @id @default(cuid())
  ledgerCode     String?                 @unique
  name           String
  groupId        String
  company        String?
  branch         String?
  gstApplicable  Boolean                 @default(false)
  gstin          String?
  pan            String?
  tdsApplicable  Boolean                 @default(false)
  tdsSection     String?
  openingBalance Float                   @default(0)
  balanceType    String                  @default("Dr")
  status         String                  @default("Active")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  journalEntries AccountsJournalDetail[]
  group          AccountsAccountGroup    @relation(fields: [groupId], references: [id])
  tdsAdjustments TdsAdjustment[]
}

model AccountsJournal {
  id            String                  @id @default(cuid())
  voucherNo     String                  @unique
  voucherDate   DateTime                @default(now())
  type          String
  company       String?
  branch        String?
  project       String?
  costCentre    String?
  narration     String?
  totalAmount   Float                   @default(0)
  status        String                  @default("Posted")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  billNo        String?
  billDate      DateTime?
  dueDate       DateTime?
  details       AccountsJournalDetail[]
  tdsChallans   TdsChallan[]
  tdsDeductions TdsDeduction[]
}

model AccountsJournalDetail {
  id        String               @id @default(cuid())
  journalId String
  ledgerId  String
  type      String
  amount    Float
  narration String?
  journal   AccountsJournal      @relation(fields: [journalId], references: [id], onDelete: Cascade)
  ledger    AccountsLedgerMaster @relation(fields: [ledgerId], references: [id])
}

model AccountsBankMaster {
  id             String                    @id @default(cuid())
  bankName       String
  accountNumber  String                    @unique
  ifsc           String?
  branch         String?
  accountType    String?
  company        String?
  openingBalance Float                     @default(0)
  currentBalance Float                     @default(0)
  status         String                    @default("Active")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  transactions   AccountsBankTransaction[]
  tdsAdjustments TdsAdjustment[]
  tdsChallans    TdsChallan[]
}

model AccountsBankTransaction {
  id          String             @id @default(cuid())
  bankId      String
  date        DateTime           @default(now())
  type        String
  amount      Float
  referenceNo String?
  party       String?
  narration   String?
  status      String             @default("Cleared")
  createdAt   DateTime           @default(now())
  bank        AccountsBankMaster @relation(fields: [bankId], references: [id])
}

model AccountsChequeBook {
  id          Int      @id @default(autoincrement())
