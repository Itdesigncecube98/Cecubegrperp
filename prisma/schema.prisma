model TenderMaster {
  id          String   @id @default(cuid())
  type        String   // HOLDING_COMPANY | WORK_CATEGORY | OVERHEAD_CATEGORY | TENDER_STAGE
  name        String
  code        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, name])
  @@index([type])
}

model AdminTool {
  id          String            @id @default(cuid())
  module      String            // Contracting | Engineering | Purchase | Site | ...
  name        String            // e.g. "Send WO to Contractor by Email"
  code        String?           // short machine key e.g. "WO_EMAIL"
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  roleAccess            RoleToolAccess[]
  employeeProjectAccess EmployeeProjectToolAccess[]

  @@unique([module, name])
  @@index([module])
}

model RoleToolAccess {
  id        String    @id @default(cuid())
  roleId    String
  toolId    String
  granted   Boolean   @default(true)
  createdAt DateTime  @default(now())
  tool      AdminTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([roleId, toolId])
  @@index([roleId])
  @@index([toolId])
}

// Granular per-employee, per-project tool access
model EmployeeProjectToolAccess {
  id         String    @id @default(cuid())
  employeeId String
  projectId  String
  toolId     String
  granted    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  tool       AdminTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([employeeId, projectId, toolId])
  @@index([employeeId])
  @@index([projectId])
  @@index([toolId])
}