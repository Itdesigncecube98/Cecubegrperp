  updatedAt    DateTime      @updatedAt
  payments     TDSPayment[]
  company      Company       @relation(fields: [companyId], references: [id])
  tdsAccount   Ledger        @relation("TDSAccountRelation", fields: [tdsAccountId], references: [id])

  @@unique([companyId, type, section])
  @@index([companyId])
}

model TDSChallan {
  id             String          @id @default(cuid())
