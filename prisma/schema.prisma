  challanNo      String
  challanDate    DateTime
  bsrCode        String?
  taxType        DeductionType   @default(TDS)
  section        String
  amount         Decimal
  assessmentYear String
  periodFrom     DateTime
  periodTo       DateTime
  bankName       String?
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
