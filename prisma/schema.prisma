generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id         Int    @id @default(autoincrement())
  adminId    String?
  name       String
  email      String @unique
  department String
  password   String
}

model Employee {
  id           String       @id @default(cuid())
  empId        String?
  name         String
  email        String       @unique
  password     String
  department   String
  role         String       @default("EMPLOYEE")
  supervisorId String?
  // Extended profile fields
  phone        String?
  designation  String?
  branch       String?
  organisation String?
  gender       String?
  maritalStatus String?
  nationality  String?
  joinedDate   String?
  photoUrl     String?
  address      String?
  emergencyContact String?
  emergencyPhone   String?
  supervisor   Employee?    @relation("SupervisorRelation", fields: [supervisorId], references: [id])
  subordinates Employee[]   @relation("SupervisorRelation")
  createdAt    DateTime     @default(now())
  attendances  Attendance[]
  punchRequests PunchRequest[]
  leaveBalance  LeaveBalance?
  leaveRequests LeaveRequest[]
  locationRequests LocationRequest[]
  documents     EmployeeDocument[]
  vehicles      Vehicle[]
  tripLogs      TripLog[]
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId String
  date       String   // stored as YYYY-MM-DD
  status     String   // Present, Absent, Late
  shiftType  String   @default("Day") // Day, Night
  timeSlots  String?  @db.Text // stores JSON array string e.g. [{"in":"09:30","out":"12:00"}]
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model PunchRequest {
  id           Int      @id @default(autoincrement())
  employeeId   String
  type         String   // "IN", "OUT", "REGULARIZE"
  time         String   // "09:30"
  date         String   // "YYYY-MM-DD"
  shiftType    String   @default("Day") // Day, Night
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason       String?  @db.Text
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveBalance {
  id           Int      @id @default(autoincrement())
  employeeId   String   @unique
  casualLeaves Float    @default(12)
  leaveWithoutPay Float    @default(0)
  earnedLeaves Float    @default(15)
  compensatoryLeaves Float @default(0)
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id           Int      @id @default(autoincrement())
  employeeId   String
  leaveType    String   // "Casual", "Sick", "Earned", "Unpaid", "COFF"
  startDate    String   // "YYYY-MM-DD"
  endDate      String   // "YYYY-MM-DD"
  reason       String   @db.Text
  attachment   String?  // Base64 encoded file data
  status       String   @default("PENDING_SUPERVISOR") // PENDING_SUPERVISOR, PENDING_ADMIN, APPROVED, REJECTED
  isHalfDay    Boolean  @default(false)
  appliedOn    DateTime @default(now())
  supervisorApproved Boolean @default(false)
  supervisorApprovedAt DateTime?
  supervisorApprovedBy String?
  adminApproved Boolean @default(false)
  adminApprovedAt DateTime?
  adminApprovedBy String?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Holiday {
  id           Int      @id @default(autoincrement())
  name         String
  date         String   @unique // "YYYY-MM-DD"
  type         String   @default("Public") // Public, Optional
}

model AccountSettings {
  id                     Int      @id @default(autoincrement())
  companyName            String   @default("Cecube Engineering India Pvt Ltd")
  holidayPunchHandling   String   @default("PROCESS_AS_REGULAR")
  weekOffPunchHandling   String   @default("PROCESS_AS_REGULAR")
  enableOvertime         Boolean  @default(false)
  computeOvertimeBasedOn String   @default("WORKED_HOURS")
  otStartMinutes         Int      @default(0)
  otDailyCapHours        Int      @default(0)
  updatedAt              DateTime @updatedAt
}

model WorkWeek {
  id         Int     @id @default(autoincrement())
  day        String  @unique
  isWorking  Boolean @default(true)
}

model LeaveType {
  id                Int     @id @default(autoincrement())
  name              String
  isPaid            Boolean @default(false)
  isActive          Boolean @default(true)
  includeWeeklyOff  Boolean @default(false)
  includeHoliday    Boolean @default(false)
  considerAsPresent Boolean @default(false)
}

model GpsLocation {
  id           Int     @id @default(autoincrement())
  name         String
  address      String?
  latitude     Float
  longitude    Float
  radiusMeters Int     @default(100)
  locationType String  @default("Office") // Office, Site, Client
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  subject   String
  message   String?  @db.Text
  isHoliday Boolean  @default(false)
  date      String?  // YYYY-MM-DD format if it is a holiday
  createdAt DateTime @default(now())
}

model LocationRequest {
  id           Int      @id @default(autoincrement())
  employeeId   String
  status       String   @default("PENDING") // PENDING, COMPLETED, FAILED
  latitude     Float?
  longitude    Float?
  address      String?
  movementType String?  // e.g., "Office to Site"
  requestedAt  DateTime @default(now())
  respondedAt  DateTime?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pings        LocationPing[]
}

model LocationPing {
  id         Int             @id @default(autoincrement())
  requestId  Int
  latitude   Float
  longitude  Float
  timestamp  DateTime        @default(now())
  request    LocationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model EmployeeDocument {
  id             Int      @id @default(autoincrement())
  employeeId     String
  documentType   String   // "Personal" or "Dependent"
  documentName   String   // e.g. "Aadhar Card"
  documentNumber String?
  expiryDate     String?  // "YYYY-MM-DD"
  fileData       String   // Base64 encoded file data
  fileName       String
  fileType       String   // e.g. "application/pdf", "image/png"
  createdAt      DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id               Int      @id @default(autoincrement())
  employeeId       String?
  isCompanyVehicle Boolean  @default(false)
  makeModel        String
  plateNumber      String   @unique
  vehicleType      String
  ratePerKm        Float    @default(0.0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  employee         Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trips            TripLog[]
}

model TripLog {
  id           Int      @id @default(autoincrement())
  employeeId   String
  vehicleId    Int
  date         String?
  startLocation String?
  endLocation  String?
  distanceKm   Float?   @default(0.0)
  amount       Float?   @default(0.0)
  status       String   @default("REQUESTED") // REQUESTED, ACTIVE, COMPLETED, APPROVED, REJECTED, PAID
  createdAt    DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  pings        TripPing[]
}

model TripPing {
  id         Int      @id @default(autoincrement())
  tripId     Int
  latitude   Float
  longitude  Float
  timestamp  DateTime @default(now())
  trip       TripLog  @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id              Int      @id @default(autoincrement())
  subject         String
  message         String   @db.Text
  recipientCount  Int      @default(0)
  recipientEmails String?  @db.Text
  recipientNames  String?  @db.Text
  attachmentName  String?
  emailType       String   @default("general")
  status          String   @default("SENT") // SENT, FAILED
  errorMessage    String?
  sentBy          String?
  createdAt       DateTime @default(now())
}
