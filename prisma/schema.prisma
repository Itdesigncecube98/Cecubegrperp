}

model Ledger {
  id               String         @id @default(cuid())
  name             String         @unique
  groupName        String
  openingBalanceDr Float          @default(0)
  openingBalanceCr Float          @default(0)
  isCashOrBank     Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  companyId        String?
  isStockInHand    Boolean        @default(false)
