# Database connection used by Prisma and the server APIs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional SMTP settings used by email notifications.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
SMTP_FROM_NAME="CeCube Engineering"
SMTP_FROM_EMAIL=""
SMTP_EMAIL=""
SMTP_EMAIL_HR=""
SMTP_PASSWORD_HR=""
SMTP_EMAIL_CONTACT=""
SMTP_PASSWORD_CONTACT=""

# Optional scheduled-job protection.
CRON_SECRET=""

# Optional login seed/configuration values, if used by the deployment.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""